# Comma-separated allowed frontend origins
FRONTEND_URL=http://localhost:5173,http://localhost:5176

# Set to a persistent mounted disk path in production if available
UPLOAD_DIR=./uploads

DATABASE_URL=sqlite:///./savvy_energy.db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=1440
